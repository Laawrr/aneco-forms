# Copy to .env.local and fill values
DATABASE_URL=mysql://user:pass@localhost:3306/dbname
# Secrets for signing tokens (use long random strings)
JWT_ACCESS_TOKEN_SECRET=changeme_access_secret
# Access token lifetime (string supported by jose): e.g. "15m"
JWT_ACCESS_TOKEN_EXPIRES=15m
# Refresh token lifetime in days
REFRESH_TOKEN_EXPIRES_DAYS=30

# Optional: adjust bcrypt salt rounds
BCRYPT_SALT_ROUNDS=10
